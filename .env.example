# Hugging Face credentials. Copy to .env and fill locally.
HF_TOKEN=

# Optional defaults for upload commands.
HF_UPLOAD_REPO_ID=
HF_UPLOAD_PRIVATE=false

# Optional dataset/output defaults.
HF_DATASET_ID=minoruskore/anime-faces-256
HF_DATASET_SPLIT=train
PIXEL_OUTPUT_DIR=data/pixelized/anime-faces-256

# Optional Pixelization defaults.
PIXELIZATION_REPO=vendor/Pixelization
PIXELIZATION_MODEL_NAME=
